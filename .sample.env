HOST=0.0.0.0
PORT=5000

# Debug and logging settings
DEBUG=0
LOG_LEVEL=INFO

# Hook settings
ALLOWED_HOOK_PROTOCOLS=http

# CORS settings
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*

# Celery configuration
CELERY_BROKER_URL=amqp://guest:guest@127.0.0.1:5672
CELERY_RESULT_BACKEND=db+postgresql://postgres:postgres@127.0.0.1:5432/postgres
CELERY_RESULT_EXPIRES=86400

# Database connections
DATABASE_URI=postgresql+asyncpg://postgres:postgres@172.29.3.30:5432/task_schedule_db
DATABASE_MYSQL_URI=postgresql+asyncpg://postgres:postgres@localhost:55432/frtu_conf_db