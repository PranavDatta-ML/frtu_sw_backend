HOST=0.0.0.0
PORT=5000

# Debug and logging settings
DEBUG=0
LOG_LEVEL=INFO

# Hook settings
ALLOWED_HOOK_PROTOCOLS=http

# CORS settings
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*

# Celery configuration
CELERY_BROKER_URL=amqp://guest:guest@127.0.0.1:5672
CELERY_RESULT_BACKEND=db+postgresql://postgres:postgres@127.0.0.1:5432/postgres
CELERY_RESULT_EXPIRES=86400

# Database connections
# OLD ETLab DB (commented out)
# DATABASE_URI=postgresql+asyncpg://postgres:postgres@172.29.3.30:5432/task_schedule_db

# New Aurora DB
DATABASE_URI=postgresql+asyncpg://postgres:***REMOVED-DB-PASSWORD***@frtu-db-cluster.cluster-cfuwga4qmhc5.ap-south-1.rds.amazonaws.com:5432/frtu_conf_db

# OLD ETLab DB (commented out)
# DATABASE_MYSQL_URI=postgresql+asyncpg://postgres:***REMOVED-DB-PASSWORD-2***@localhost:5432/frtu_conf_db

# NEW Aurora DB
DATABASE_MYSQL_URI=postgresql+asyncpg://postgres:***REMOVED-DB-PASSWORD***@frtu-db-cluster.cluster-cfuwga4qmhc5.ap-south-1.rds.amazonaws.com:5432/frtu_conf_db

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# SES Email Configuration
SES_HOST=email-smtp.ap-south-1.amazonaws.com
SES_PORT=587
SES_USERNAME=***REMOVED-AWS-ACCESS-KEY***
SES_PASSWORD=***REMOVED-AWS-SECRET-KEY***
SES_FROM_EMAIL=message-noreply@kimbal.io